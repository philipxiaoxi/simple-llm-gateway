(function(){
  try {
    var saved = localStorage.getItem('aihot-theme');
    /* Default fallback is 'auto' (follow OS prefers-color-scheme), not a hard
       'dark'. First-time visitors get the theme their device already runs:
       dark device → dark site, light device → light site. Users can still pin
       a fixed "深色"/"浅色" segment to override their OS preference. */
    var mode = (saved === 'dark' || saved === 'light' || saved === 'auto') ? saved : 'auto';
    var actual = mode;
    if (mode === 'auto') {
      actual = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    var root = document.documentElement;
    root.setAttribute('data-theme', actual);
    root.setAttribute('data-theme-mode', mode);
    var meta = document.getElementById('theme-color-dynamic');
    if (meta) meta.setAttribute('content', actual === 'light' ? '#faf9f6' : '#13191c');
    /* JS is available, so the two media-conditioned no-JS fallbacks below must go:
       per the HTML spec the FIRST theme-color meta in tree order whose media
       matches wins, and one of the fallback pair always matches — they would
       override the dynamic tag forever (e.g. user pins light while the OS is
       dark and the browser chrome still turns dark). With JS disabled this
       script never runs and the pair keeps working as before.
       React 19 hydration later re-inserts removed head tags and appends a
       pristine copy of the dynamic tag; ThemeToggle's mount effect collapses
       those back to a single correct meta (see syncThemeColorMeta). */
    var fallbacks = document.querySelectorAll('meta[name="theme-color"][media]');
    for (var i = 0; i < fallbacks.length; i++) {
      fallbacks[i].parentNode.removeChild(fallbacks[i]);
    }
  } catch (e) {
    document.documentElement.setAttribute('data-theme', 'dark');
    document.documentElement.setAttribute('data-theme-mode', 'dark');
  }
})();
3:T4ff,
(function(){
  try {
    var p = location.pathname;
    if (!(p === '/' || p === '' || p === '/all' || p.indexOf('/all/') === 0)) return;
    var raw = localStorage.getItem('aihot-read-items');
    if (!raw) return;
    var ids = JSON.parse(raw);
    if (!Array.isArray(ids) || ids.length === 0) return;
    var set = new Set(ids);
    function mark(el) {
      if (el.nodeType !== 1) return;
      if (el.hasAttribute('data-item-id') && set.has(el.getAttribute('data-item-id'))) {
        el.classList.add('fc-read');
      }
      var list = el.querySelectorAll('[data-item-id]');
      for (var i = 0; i < list.length; i++) {
        if (set.has(list[i].getAttribute('data-item-id'))) list[i].classList.add('fc-read');
      }
    }
    var observer = new MutationObserver(function(mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var added = mutations[i].addedNodes;
        for (var j = 0; j < added.length; j++) mark(added[j]);
      }
    });
    observer.observe(document.documentElement, { childList: true, subtree: true });
    document.addEventListener('DOMContentLoaded', function() {
      observer.disconnect();
      mark(document.body);
    });
  } catch (e) { /* storage disabled — 首帧后置灰由 ReadStateApplier 兜底 */ }
})();
