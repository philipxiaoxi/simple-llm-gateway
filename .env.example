APP_SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_PATH=data/gateway.db
APP_BASE_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=120
# 网关代理与 Backend 的共享密钥。设置后，网关代理连接 wss://你的站/agent/connect。
# LOCAL_AGENT_TOKEN=replace-with-a-long-random-agent-token
# 上游账号额度自动刷新间隔，默认 3600 秒（1 小时）
# QUOTA_REFRESH_INTERVAL_SECONDS=3600
# XAI_OAUTH_CLIENT_ID=
# 官方 Grok CLI 客户端只能回调 http://127.0.0.1:56121/callback，本地和线上都在后台粘贴该链接。
# 仅当你注册了自己的 xAI OAuth 应用时，才改成站点上的 /api/admin/oauth/grok/callback
# XAI_OAUTH_REDIRECT_URI=http://127.0.0.1:56121/callback
