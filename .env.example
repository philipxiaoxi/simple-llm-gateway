APP_SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_PATH=data/gateway.db
APP_BASE_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=120
# 网关代理与 Backend 的共享密钥。设置后，网关代理连接 wss://你的站/agent/connect。
# LOCAL_AGENT_TOKEN=replace-with-a-long-random-agent-token
# 上游账号额度自动刷新间隔，默认 3600 秒（1 小时）
# QUOTA_REFRESH_INTERVAL_SECONDS=3600
# 额度查询超时（秒），默认 20；连接阶段上限 5 秒，上游不可达时快速失败
# QUOTA_TIMEOUT_SECONDS=20
# Skills 文件目录。不填则与数据库同级，例如 data/skills
# SKILLS_PATH=data/skills
# XAI_OAUTH_CLIENT_ID=
# 官方 Grok CLI 客户端只能回调 http://127.0.0.1:56121/callback，本地和线上都在后台粘贴该链接。
# 仅当你注册了自己的 xAI OAuth 应用时，才改成站点上的 /api/admin/oauth/grok/callback
# XAI_OAUTH_REDIRECT_URI=http://127.0.0.1:56121/callback

# ---- 语音输入（手机 → 电脑）----
# 阿里云百炼（DashScope）实时语音识别 API Key，格式 sk-ws-…，只存服务端，绝不下发到浏览器。
# 获取：https://help.aliyun.com/zh/model-studio/get-api-key
# ALIYUN_DASHSCOPE_API_KEY=sk-ws-xxxxxxxx
# 识别模型，默认 qwen-audio-3.0-asr-flash-streaming（可选 fun-asr-realtime / paraformer-realtime-v2）
# ALIYUN_ASR_MODEL=qwen-audio-3.0-asr-flash-streaming
# WebSocket 端点，换地域时才需要改
# ALIYUN_ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# 桌面客户端共享令牌。设置后 voice-desktop 可以直接用它连接房间。
# VOICE_DESKTOP_TOKEN=replace-with-a-long-random-token
# AI 纠错的 token 预算。推理型模型会把预算花在思考上，512 会导致输出为空，默认 2048。
# VOICE_POLISH_MAX_TOKENS=2048
# AI 纠错超时（秒）
# VOICE_POLISH_TIMEOUT_SECONDS=12
# 单次录音上限（秒）
# VOICE_MAX_RECORDING_SECONDS=120
# 语音日志（段落 + 事件）保留天数，默认 30；后台房间页可手动清理
# VOICE_EVENT_RETENTION_DAYS=30

# ---- MCP 能力平面 / 知识库 ----
# OpenAI 兼容 embeddings（向量检索）。不配则开发环境用本地 Fake embedding。
# MCP_EMBEDDING_BASE_URL=https://api.openai.com/v1
# MCP_EMBEDDING_API_KEY=sk-xxx
# MCP_EMBEDDING_MODEL=text-embedding-3-small
# 向量库目录。留空时默认与数据库同级（Docker 下即 /data/chroma，已被 ./data 卷覆盖）。
# 相对路径按数据库所在目录解析，建议留空或用绝对路径。
# MCP_CHROMA_PATH=/data/chroma
# MCP_KNOWLEDGE_MAX_BYTES=2097152
# 目录批量上传：单次最多文件数与总字节上限
# MCP_KNOWLEDGE_BATCH_MAX_FILES=200
# MCP_KNOWLEDGE_BATCH_MAX_TOTAL_BYTES=67108864
# MCP_CHUNK_SIZE=700
# MCP_CHUNK_OVERLAP=100
# MCP_CAPABILITY_TIMEOUT_SECONDS=60
# 单次向量化批大小（智谱 embedding 数组上限 64）
# MCP_EMBEDDING_BATCH_SIZE=16
# 采集任务并发与最大重试次数
# MCP_KNOWLEDGE_JOB_CONCURRENCY=1
# MCP_KNOWLEDGE_JOB_MAX_ATTEMPTS=3
# 检索命中单块回传字符上限
# MCP_KNOWLEDGE_MAX_HIT_CHARS=2000
# 已结束采集任务 / 调用日志保留天数（每日清理）
# MCP_KNOWLEDGE_JOB_RETENTION_DAYS=30
# MCP_CALL_LOG_RETENTION_DAYS=30
# 文档转 Markdown。文件目录留空时与数据库同级（Docker 下即 /data/docparse，已被 ./data 卷覆盖）。
# DOC_PARSE_PATH=
# DOC_PARSE_MAX_BYTES=31457280
# DOC_PARSE_MAX_PDF_PAGES=200
# DOC_PARSE_TIMEOUT_SECONDS=180
# DOC_PARSE_RETENTION_DAYS=7
# DOC_PARSE_OCR=0
# 站点部署。静态资源目录留空时与数据库同级（Docker 下即 /data/sites，已被 ./data 卷覆盖）。
# SITE_DEPLOY_PATH=
# SITE_DEFAULT_ENTRY=index.html
# SITE_MAX_ARCHIVE_BYTES=52428800
# SITE_MAX_TOTAL_BYTES=209715200
# SITE_MAX_FILE_BYTES=52428800
# SITE_MAX_FILES=5000
# SITE_MAX_RATIO=100
# SITE_MAX_VERSIONS=10
# SITE_RETENTION_DAYS=30
# SITE_MCP_MAX_BYTES=10485760
